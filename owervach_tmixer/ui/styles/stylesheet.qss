/* Overwatch-inspired stylesheet for PySide6 */

/* Color Palette */
:root {
    --ow-orange: #FF7B00;
    --ow-orange-dark: #E66B00;
    --ow-orange-light: #FFA533;
    --ow-blue: #00B4FF;
    --ow-blue-dark: #0099CC;
    --ow-red: #FF4444;
    --ow-red-dark: #CC3333;
    --ow-gold: #FFD700;
    --ow-gold-dark: #E6C200;
    --ow-white: #FFFFFF;
    --ow-off-white: #F0F0F0;
    --ow-light-gray: #E0E0E0;
    --ow-gray: #999999;
    --ow-dark-gray: #666666;
    --ow-darker-gray: #444444;
    --ow-black: #1A1A1A;
    --ow-card-bg: #252525;
    --ow-panel-bg: #1E1E1E;
    --ow-border: #333333;
    --ow-border-light: #444444;
    --ow-success: #4CAF50;
    --ow-warning: #FF9800;
    --ow-error: #F44336;
}

/* Global */
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: var(--ow-off-white);
}

QMainWindow {
    background-color: var(--ow-black);
}

/* Root fix: neutral containers are transparent by default so nested frames
   inside chips/slots/panels never paint phantom gray boxes. Backgrounds and
   borders live ONLY on specific panel/slot/chip selectors. */
QFrame {
    background-color: transparent;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    background: var(--ow-panel-bg);
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: var(--ow-darker-gray);
    min-height: 30px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: var(--ow-gray);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* Buttons */
QPushButton {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    color: var(--ow-white);
    min-height: 20px;
}
QPushButton:hover {
    background-color: var(--ow-darker-gray);
    border-color: var(--ow-border-light);
}
QPushButton:pressed {
    background-color: var(--ow-black);
}
QPushButton:disabled {
    background-color: var(--ow-panel-bg);
    color: var(--ow-dark-gray);
    border-color: var(--ow-border);
}

/* Primary button (orange) */
QPushButton[primary="true"] {
    background-color: var(--ow-orange);
    border-color: var(--ow-orange-dark);
    color: var(--ow-white);
}
QPushButton[primary="true"]:hover {
    background-color: var(--ow-orange-light);
}
QPushButton[primary="true"]:pressed {
    background-color: var(--ow-orange-dark);
}

/* Danger button (red) */
QPushButton[danger="true"] {
    background-color: var(--ow-red);
    border-color: var(--ow-red-dark);
}
QPushButton[danger="true"]:hover {
    background-color: #FF6666;
}
QPushButton[danger="true"]:pressed {
    background-color: var(--ow-red-dark);
}

/* Success button (green) */
QPushButton[success="true"] {
    background-color: var(--ow-success);
    border-color: #388E3C;
}
QPushButton[success="true"]:hover {
    background-color: #66BB6A;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid var(--ow-border);
    background-color: var(--ow-panel-bg);
    border-radius: 0 0 6px 6px;
}

QTabBar::tab {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 20px;
    margin-right: 2px;
    font-weight: 500;
    color: var(--ow-gray);
}
QTabBar::tab:selected {
    background-color: var(--ow-panel-bg);
    color: var(--ow-orange);
    border-bottom: 2px solid var(--ow-orange);
}
QTabBar::tab:hover:!selected {
    color: var(--ow-white);
    background-color: var(--ow-darker-gray);
}

/* Group Box */
QGroupBox {
    border: 1px solid var(--ow-border);
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
    color: var(--ow-orange);
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    background-color: var(--ow-panel-bg);
}

/* Embedded transparent editors/labels (inside slots & chips). */
QLineEdit[transparent="true"],
QLabel[transparent="true"] {
    background-color: transparent;
    border: none;
    outline: none;
}

/* Line Edit */
QLineEdit {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 8px 12px;
    color: var(--ow-white);
    selection-background-color: var(--ow-orange);
}
QLineEdit:focus {
    border-color: var(--ow-orange);
}
QLineEdit:disabled {
    background-color: var(--ow-panel-bg);
    color: var(--ow-dark-gray);
}

/* Text Edit */
QTextEdit {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 8px;
    color: var(--ow-white);
    selection-background-color: var(--ow-orange);
}
QTextEdit:focus {
    border-color: var(--ow-orange);
}

/* Combo Box */
QComboBox {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 6px 12px;
    color: var(--ow-white);
    min-height: 20px;
}
QComboBox:hover {
    border-color: var(--ow-border-light);
}
QComboBox:focus {
    border-color: var(--ow-orange);
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(assets/chevron_down.svg);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    selection-background-color: var(--ow-orange);
    color: var(--ow-white);
}

/* Spin Box */
QSpinBox {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 6px 12px;
    color: var(--ow-white);
}
QSpinBox:focus {
    border-color: var(--ow-orange);
}
QSpinBox::up-button,
QSpinBox::down-button {
    background-color: var(--ow-darker-gray);
    border: none;
    width: 20px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: var(--ow-gray);
}

/* Check Box */
QCheckBox {
    spacing: 8px;
    color: var(--ow-white);
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid var(--ow-border);
    border-radius: 4px;
    background-color: var(--ow-card-bg);
}
QCheckBox::indicator:checked {
    background-color: var(--ow-orange);
    border-color: var(--ow-orange);
    image: url(assets/check.svg);
}
QCheckBox::indicator:hover {
    border-color: var(--ow-orange);
}

/* Radio Button */
QRadioButton {
    spacing: 8px;
    color: var(--ow-white);
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid var(--ow-border);
    border-radius: 9px;
    background-color: var(--ow-card-bg);
}
QRadioButton::indicator:checked {
    background-color: var(--ow-orange);
    border-color: var(--ow-orange);
}
QRadioButton::indicator:hover {
    border-color: var(--ow-orange);
}

/* List Widget */
QListWidget {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: var(--ow-white);
}
QListWidget::item:selected {
    background-color: var(--ow-orange);
    color: var(--ow-white);
}
QListWidget::item:hover:!selected {
    background-color: var(--ow-darker-gray);
}

/* List View (for combo box dropdowns) */
QListView {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    outline: none;
}
QListView::item {
    padding: 8px 12px;
}
QListView::item:selected {
    background-color: var(--ow-orange);
    color: var(--ow-white);
}

/* Tree Widget */
QTreeWidget {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    outline: none;
}
QTreeWidget::item {
    padding: 6px 8px;
}
QTreeWidget::item:selected {
    background-color: var(--ow-orange);
}
QHeaderView::section {
    background-color: var(--ow-darker-gray);
    border: none;
    border-right: 1px solid var(--ow-border);
    border-bottom: 1px solid var(--ow-border);
    padding: 8px;
    font-weight: 600;
    color: var(--ow-orange);
}

/* Slider */
QSlider::groove:horizontal {
    height: 6px;
    background: var(--ow-border);
    border-radius: 3px;
}
QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background: var(--ow-orange);
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: var(--ow-orange-light);
}

/* Progress Bar */
QProgressBar {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    text-align: center;
    color: var(--ow-white);
}
QProgressBar::chunk {
    background-color: var(--ow-orange);
    border-radius: 5px;
}

/* Tool Tip */
QToolTip {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-orange);
    border-radius: 6px;
    padding: 8px 12px;
    color: var(--ow-white);
    font-size: 12px;
}

/* Menu */
QMenu {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: var(--ow-orange);
}
QMenu::separator {
    height: 1px;
    background: var(--ow-border);
    margin: 4px 8px;
}

/* Dialog */
QDialog {
    background-color: var(--ow-panel-bg);
}

/* Message Box */
QMessageBox {
    background-color: var(--ow-panel-bg);
}
QMessageBox QLabel {
    color: var(--ow-white);
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* Splitter */
QSplitter::handle {
    background-color: var(--ow-border);
    width: 2px;
}
QSplitter::handle:hover {
    background-color: var(--ow-orange);
}

/* Custom Widgets - Team Panels */
.TeamPanel {
    background-color: var(--ow-card-bg);
    border: 2px solid var(--ow-border);
    border-radius: 10px;
}
.TeamPanel[team="1"] {
    border-color: var(--ow-blue);
}
.TeamPanel[team="2"] {
    border-color: var(--ow-red);
}

.TeamPanelHeader {
    background-color: var(--ow-darker-gray);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 12px;
    border-bottom: 1px solid var(--ow-border);
}

.TeamPanelTitle {
    font-size: 18px;
    font-weight: 700;
    color: var(--ow-white);
}

.TeamPanel[team="1"] .TeamPanelTitle {
    color: var(--ow-blue);
}
.TeamPanel[team="2"] .TeamPanelTitle {
    color: var(--ow-red);
}

/* Player Item */
.PlayerItem {
    background-color: transparent;
    border-radius: 6px;
    padding: 6px 10px;
}
.PlayerItem:hover {
    background-color: var(--ow-darker-gray);
}
.PlayerItem[fixed="true"] {
    background-color: rgba(255, 123, 0, 0.1);
    border-left: 3px solid var(--ow-orange);
}

.PlayerName {
    font-weight: 600;
    font-size: 14px;
    color: var(--ow-white);
}

.PlayerRole {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    color: var(--ow-white);
}
.PlayerRole[role="tank"] {
    background-color: var(--ow-blue);
}
.PlayerRole[role="damage"] {
    background-color: var(--ow-red);
}
.PlayerRole[role="support"] {
    background-color: var(--ow-gold);
    color: var(--ow-black);
}

/* Map Display */
.MapDisplay {
    background-color: var(--ow-card-bg);
    border: 2px solid var(--ow-border);
    border-radius: 10px;
    padding: 16px;
}
.MapDisplay .MapName {
    font-size: 24px;
    font-weight: 700;
    color: var(--ow-white);
}
.MapDisplay .MapMode {
    font-size: 14px;
    font-weight: 600;
    color: var(--ow-orange);
    padding: 4px 12px;
    background-color: rgba(255, 123, 0, 0.15);
    border-radius: 12px;
    display: inline-block;
}

/* Ban List */
.BanList {
    background-color: var(--ow-card-bg);
    border: 1px solid var(--ow-border);
    border-radius: 8px;
    padding: 8px;
}
.BanItem {
    color: var(--ow-red);
    font-weight: 500;
}

/* VS Divider */
.VSDivider {
    color: var(--ow-gray);
    font-size: 28px;
    font-weight: 700;
}

/* Status Bar */
QStatusBar {
    background-color: var(--ow-panel-bg);
    border-top: 1px solid var(--ow-border);
    color: var(--ow-gray);
    font-size: 12px;
}

/* Tool Bar */
QToolBar {
    background-color: var(--ow-panel-bg);
    border: none;
    border-bottom: 1px solid var(--ow-border);
    spacing: 4px;
    padding: 4px;
}

/* Label */
QLabel {
    color: var(--ow-white);
}

/* Separator Line */
QFrame[frameShape="4"] { /* HLine */
    color: var(--ow-border);
}
QFrame[frameShape="5"] { /* VLine */
    color: var(--ow-border);
}